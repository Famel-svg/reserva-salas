# Copie para .env e preencha. Nunca commite o .env.

# Obrigatório. Mínimo de 32 caracteres (HS256). Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-com-no-minimo-32-caracteres

# Opcional. Duração do token de acesso (ISO 8601).
JWT_TTL=PT15M

# Banco. Com docker-compose já vêm configurados.
DB_URL=jdbc:postgresql://localhost:5432/reserva_salas
DB_USER=reserva
DB_PASSWORD=reserva

# Perfil dev: cria o ADMIN inicial no startup. Não existe em migration.
SPRING_PROFILES_ACTIVE=dev
ADMIN_EMAIL=admin@reserva.local
ADMIN_PASSWORD=troque-esta-senha-de-dev
